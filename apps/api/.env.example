# Server
NODE_ENV=development
PORT=4000
API_GLOBAL_PREFIX=api
CORS_ORIGINS=http://localhost:5173
# Public origin of the web app — used to build invite links emailed to approved allies
WEB_APP_URL=http://localhost:5173

# Database — Neon recommended
# Use the POOLED url (-pooler in host) for DATABASE_URL → consumed by the app at runtime
# Use the DIRECT url (no -pooler) for DIRECT_URL       → consumed by `prisma migrate`
DATABASE_URL=postgresql://spaces:spaces@localhost:5432/spaces?schema=public
DIRECT_URL=postgresql://spaces:spaces@localhost:5432/spaces?schema=public

# Auth
JWT_SECRET=replace-me-with-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Platform commission % on each customer payment (0-100). Default 10.
# The rest is owed to the venue owner and shown in the Earnings dashboard.
PLATFORM_COMMISSION_PERCENT=10

# M-Pesa Daraja (sandbox by default — fill in to enable real STK pushes)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:4000/api/payments/mpesa/callback
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# Comma-separated allowlist of source IPs allowed to hit /payments/mpesa/callback.
# Required in production. Safaricom publishes the egress IPs in the Daraja docs;
# keep this in sync (they occasionally rotate).
# Sandbox + prod default set (verify with current Daraja docs before going live):
# 196.201.214.200,196.201.214.206,196.201.213.114,196.201.214.207,196.201.214.208,196.201.213.44,196.201.212.127,196.201.212.138,196.201.212.129,196.201.212.136,196.201.212.74
MPESA_ALLOWED_IPS=

# Card payments (Stripe / Flutterwave — pick one in code)
STRIPE_SECRET_KEY=

# Email — Resend (https://resend.com)
# Without RESEND_API_KEY set, the app still runs but email sends are no-ops (logged).
# MAIL_FROM must be a verified sender / domain in your Resend account.
# SUPPORT_EMAIL is where contact-form submissions are delivered.
RESEND_API_KEY=
MAIL_FROM=Qreative Spaces <hello@qreativespaces.co.ke>
SUPPORT_EMAIL=hello@qreativespaces.co.ke

# Cloudflare R2 object storage (see R2_SETUP.md at repo root)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
